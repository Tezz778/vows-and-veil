{
  "name": "RehearsalTimelineItem",
  "type": "object",
  "properties": {
    "wedding_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "time": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "number",
      "default": 30
    },
    "notes": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "wedding_id",
    "title",
    "time"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
{
  "name": "RehearsalGuest",
  "type": "object",
  "properties": {
    "wedding_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "contact": {
      "type": "string"
    },
    "rsvp_status": {
      "type": "string",
      "enum": [
        "pending",
        "yes",
        "no"
      ],
      "default": "pending"
    }
  },
  "required": [
    "wedding_id",
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
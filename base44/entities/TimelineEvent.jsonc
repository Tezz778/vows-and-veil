{
  "name": "TimelineEvent",
  "type": "object",
  "properties": {
    "wedding_id": {
      "type": "string"
    },
    "day_number": {
      "type": "number",
      "default": 1
    },
    "day_label": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "start_time": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "number",
      "default": 30
    },
    "notes": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "wedding_id",
    "title",
    "start_time"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.wedding_id": {
            "$in": "{{user.data.team_wedding_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.wedding_id": {
            "$in": "{{user.data.team_wedding_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.wedding_id": {
            "$in": "{{user.data.team_wedding_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.wedding_id": {
            "$in": "{{user.data.team_wedding_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
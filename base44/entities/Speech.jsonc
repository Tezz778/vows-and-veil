{
  "name": "Speech",
  "type": "object",
  "properties": {
    "wedding_id": {
      "type": "string"
    },
    "speaker_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "best_man",
        "maid_of_honor",
        "father_of_bride",
        "mother_of_bride",
        "parent",
        "other"
      ],
      "default": "other"
    },
    "relationship": {
      "type": "string"
    },
    "prompts": {
      "type": "object"
    },
    "draft_text": {
      "type": "string"
    }
  },
  "required": [
    "wedding_id",
    "speaker_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
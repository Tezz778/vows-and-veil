{
  "name": "Speech",
  "type": "object",
  "properties": {
    "wedding_id": {
      "type": "string"
    },
    "speaker_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "best_man",
        "maid_of_honor",
        "father_of_bride",
        "mother_of_bride",
        "parent",
        "other"
      ],
      "default": "other"
    },
    "relationship": {
      "type": "string"
    },
    "prompts": {
      "type": "object"
    },
    "draft_text": {
      "type": "string"
    },
    "share_token": {
      "type": "string"
    },
    "share_enabled": {
      "type": "boolean",
      "default": false
    },
    "share_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed"
      ],
      "default": "not_started"
    },
    "last_generated_date": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "wedding_id",
    "speaker_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
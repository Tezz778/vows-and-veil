{
  "name": "ShotListItem",
  "type": "object",
  "properties": {
    "wedding_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "done": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "wedding_id",
    "description"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
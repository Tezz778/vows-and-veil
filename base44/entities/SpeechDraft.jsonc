{
  "name": "SpeechDraft",
  "type": "object",
  "properties": {
    "wedding_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "best_man",
        "maid_of_honor",
        "father_of_bride",
        "mother_of_bride",
        "father_of_groom",
        "mother_of_groom",
        "bride",
        "groom",
        "other"
      ]
    },
    "speaker_name": {
      "type": "string"
    },
    "couple_names": {
      "type": "string"
    },
    "relationship": {
      "type": "string"
    },
    "tone": {
      "type": "string",
      "enum": [
        "heartfelt",
        "funny",
        "formal",
        "sentimental"
      ],
      "default": "heartfelt"
    },
    "prompts": {
      "type": "object"
    },
    "draft_text": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "wedding_id",
    "role"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "plan_tier": "multiday"
              }
            },
            {
              "user_condition": {
                "plan_tier": "destination"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "plan_tier": "multiday"
          }
        },
        {
          "user_condition": {
            "plan_tier": "destination"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "plan_tier": "multiday"
              }
            },
            {
              "user_condition": {
                "plan_tier": "destination"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "plan_tier": "multiday"
              }
            },
            {
              "user_condition": {
                "plan_tier": "destination"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}
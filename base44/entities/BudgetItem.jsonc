{
  "name": "BudgetItem",
  "type": "object",
  "properties": {
    "wedding_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "vendor_name": {
      "type": "string"
    },
    "estimated_amount": {
      "type": "number",
      "default": 0
    },
    "actual_amount": {
      "type": "number",
      "default": 0
    },
    "paid_amount": {
      "type": "number",
      "default": 0
    },
    "per_guest_amount": {
      "type": "number",
      "default": 0
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "wedding_id",
    "category"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.plan_tier": "single_day"
          }
        },
        {
          "user_condition": {
            "data.plan_tier": "multiday"
          }
        },
        {
          "user_condition": {
            "data.plan_tier": "destination"
          }
        },
        {
          "data.wedding_id": {
            "$in": "{{user.data.team_wedding_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.plan_tier": "single_day"
                  }
                },
                {
                  "user_condition": {
                    "data.plan_tier": "multiday"
                  }
                },
                {
                  "user_condition": {
                    "data.plan_tier": "destination"
                  }
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                }
              ]
            }
          ]
        },
        {
          "data.wedding_id": {
            "$in": "{{user.data.team_wedding_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.plan_tier": "single_day"
                  }
                },
                {
                  "user_condition": {
                    "data.plan_tier": "multiday"
                  }
                },
                {
                  "user_condition": {
                    "data.plan_tier": "destination"
                  }
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                }
              ]
            }
          ]
        },
        {
          "data.wedding_id": {
            "$in": "{{user.data.team_wedding_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.plan_tier": "single_day"
                  }
                },
                {
                  "user_condition": {
                    "data.plan_tier": "multiday"
                  }
                },
                {
                  "user_condition": {
                    "data.plan_tier": "destination"
                  }
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                }
              ]
            }
          ]
        },
        {
          "data.wedding_id": {
            "$in": "{{user.data.team_wedding_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
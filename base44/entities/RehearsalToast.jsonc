{
  "name": "RehearsalToast",
  "type": "object",
  "properties": {
    "wedding_id": {
      "type": "string"
    },
    "speaker_name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "speaking_order": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "wedding_id",
    "speaker_name"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "plan_tier": "multiday"
              }
            },
            {
              "user_condition": {
                "plan_tier": "destination"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "plan_tier": "multiday"
          }
        },
        {
          "user_condition": {
            "plan_tier": "destination"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "plan_tier": "multiday"
              }
            },
            {
              "user_condition": {
                "plan_tier": "destination"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "plan_tier": "multiday"
              }
            },
            {
              "user_condition": {
                "plan_tier": "destination"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}
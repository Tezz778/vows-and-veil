{
  "name": "RehearsalToast",
  "type": "object",
  "properties": {
    "wedding_id": {
      "type": "string"
    },
    "speaker_name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "speaking_order": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "wedding_id",
    "speaker_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
{
  "name": "Guest",
  "type": "object",
  "properties": {
    "wedding_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "table_name": {
      "type": "string"
    },
    "rsvp_status": {
      "type": "string",
      "enum": [
        "pending",
        "yes",
        "no"
      ],
      "default": "pending"
    },
    "contact": {
      "type": "string"
    },
    "plus_ones": {
      "type": "number",
      "default": 0
    },
    "plus_one_name": {
      "type": "string"
    },
    "meal_choice": {
      "type": "string"
    },
    "meal_notes": {
      "type": "string"
    },
    "invite_tier": {
      "type": "string",
      "enum": [
        "must_invite",
        "should_invite",
        "nice_to_have"
      ],
      "default": "should_invite"
    },
    "travel_needed": {
      "type": "boolean",
      "default": false
    },
    "accommodation": {
      "type": "string"
    },
    "arrival_date": {
      "type": "string",
      "format": "date"
    },
    "departure_date": {
      "type": "string",
      "format": "date"
    },
    "invitation_status": {
      "type": "string",
      "enum": [
        "not_sent",
        "save_the_date",
        "invite_sent",
        "rsvp_received"
      ],
      "default": "not_sent"
    },
    "invite_method": {
      "type": "string",
      "enum": [
        "digital",
        "mail"
      ],
      "default": "digital"
    },
    "invite_sent_date": {
      "type": "string",
      "format": "date"
    },
    "follow_up_sent": {
      "type": "boolean",
      "default": false
    },
    "attending_rehearsal": {
      "type": "boolean",
      "default": false
    },
    "rehearsal_invited": {
      "type": "boolean",
      "default": false
    },
    "rehearsal_rsvp": {
      "type": "string",
      "enum": [
        "pending",
        "yes",
        "no"
      ],
      "default": "pending"
    },
    "rehearsal_table": {
      "type": "string"
    },
    "rsvp_token": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "wedding_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.plan_tier": "multiday"
          }
        },
        {
          "user_condition": {
            "data.plan_tier": "destination"
          }
        },
        {
          "data.wedding_id": {
            "$in": "{{user.data.team_wedding_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.plan_tier": "multiday"
                  }
                },
                {
                  "user_condition": {
                    "data.plan_tier": "destination"
                  }
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                }
              ]
            }
          ]
        },
        {
          "data.wedding_id": {
            "$in": "{{user.data.team_wedding_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.plan_tier": "multiday"
                  }
                },
                {
                  "user_condition": {
                    "data.plan_tier": "destination"
                  }
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                }
              ]
            }
          ]
        },
        {
          "data.wedding_id": {
            "$in": "{{user.data.team_wedding_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.plan_tier": "multiday"
                  }
                },
                {
                  "user_condition": {
                    "data.plan_tier": "destination"
                  }
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                }
              ]
            }
          ]
        },
        {
          "data.wedding_id": {
            "$in": "{{user.data.team_wedding_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "MoodBoardItem",
  "type": "object",
  "properties": {
    "wedding_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "image",
        "color",
        "note"
      ],
      "default": "note"
    },
    "content": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    }
  },
  "required": [
    "wedding_id",
    "kind",
    "content"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
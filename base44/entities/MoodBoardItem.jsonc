{
  "name": "MoodBoardItem",
  "type": "object",
  "properties": {
    "wedding_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "image",
        "color",
        "note"
      ],
      "default": "note"
    },
    "content": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    }
  },
  "required": [
    "wedding_id",
    "kind",
    "content"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.plan_tier": "single_day"
          }
        },
        {
          "user_condition": {
            "data.plan_tier": "multiday"
          }
        },
        {
          "user_condition": {
            "data.plan_tier": "destination"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.plan_tier": "single_day"
              }
            },
            {
              "user_condition": {
                "data.plan_tier": "multiday"
              }
            },
            {
              "user_condition": {
                "data.plan_tier": "destination"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.plan_tier": "single_day"
              }
            },
            {
              "user_condition": {
                "data.plan_tier": "multiday"
              }
            },
            {
              "user_condition": {
                "data.plan_tier": "destination"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.plan_tier": "single_day"
              }
            },
            {
              "user_condition": {
                "data.plan_tier": "multiday"
              }
            },
            {
              "user_condition": {
                "data.plan_tier": "destination"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}
{
  "name": "WeatherBackup",
  "type": "object",
  "properties": {
    "wedding_id": {
      "type": "string"
    },
    "forecast": {
      "type": "string"
    },
    "backup_plan": {
      "type": "string"
    },
    "indoor_alternative": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "wedding_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
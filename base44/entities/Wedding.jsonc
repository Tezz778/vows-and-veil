{
  "name": "Wedding",
  "type": "object",
  "properties": {
    "couple_names": {
      "type": "string"
    },
    "wedding_date": {
      "type": "string",
      "format": "date"
    },
    "venue_name": {
      "type": "string"
    },
    "venue_location": {
      "type": "string"
    },
    "wedding_type": {
      "type": "string",
      "enum": [
        "single_day",
        "multiday",
        "destination"
      ]
    },
    "has_planner": {
      "type": "boolean",
      "default": false
    },
    "planner_contact": {
      "type": "string"
    },
    "photographer_status": {
      "type": "string",
      "enum": [
        "photographer",
        "videographer",
        "both",
        "neither"
      ]
    },
    "guest_count": {
      "type": "number",
      "default": 0
    },
    "budget_range": {
      "type": "string"
    },
    "selected_tier": {
      "type": "string",
      "enum": [
        "single_day",
        "multiday",
        "destination"
      ]
    },
    "has_paid": {
      "type": "boolean",
      "default": false
    },
    "budget_upgraded": {
      "type": "boolean",
      "default": false
    },
    "access_expires_date": {
      "type": "string",
      "format": "date"
    },
    "style_notes": {
      "type": "string"
    },
    "wedding_colors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pinterest_inspirations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "inspiration_photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          }
        }
      }
    },
    "site_slug": {
      "type": "string"
    },
    "site_message": {
      "type": "string"
    },
    "site_hero_image": {
      "type": "string"
    },
    "site_story": {
      "type": "string"
    },
    "site_photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          }
        }
      }
    },
    "site_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "image": {
            "type": "string"
          }
        }
      }
    },
    "site_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "store_name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "site_meal_options": {
      "type": "string"
    }
  },
  "required": [
    "couple_names",
    "wedding_date",
    "wedding_type"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
{
  "name": "MomentIdea",
  "type": "object",
  "properties": {
    "wedding_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "send_off",
        "dance",
        "ceremony",
        "reception",
        "other"
      ]
    }
  },
  "required": [
    "wedding_id",
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
{
  "name": "MoodBoard",
  "type": "object",
  "properties": {
    "wedding_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "color_palette": {
      "type": "string"
    },
    "style_notes": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "decor",
        "attire",
        "florals",
        "venue",
        "stationery",
        "other"
      ],
      "default": "decor"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "wedding_id",
    "title"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "plan_tier": "single_day"
              }
            },
            {
              "user_condition": {
                "plan_tier": "multiday"
              }
            },
            {
              "user_condition": {
                "plan_tier": "destination"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "plan_tier": "single_day"
          }
        },
        {
          "user_condition": {
            "plan_tier": "multiday"
          }
        },
        {
          "user_condition": {
            "plan_tier": "destination"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "plan_tier": "single_day"
              }
            },
            {
              "user_condition": {
                "plan_tier": "multiday"
              }
            },
            {
              "user_condition": {
                "plan_tier": "destination"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "plan_tier": "single_day"
              }
            },
            {
              "user_condition": {
                "plan_tier": "multiday"
              }
            },
            {
              "user_condition": {
                "plan_tier": "destination"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}
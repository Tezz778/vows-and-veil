{
  "name": "SeatingTable",
  "type": "object",
  "properties": {
    "wedding_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "capacity": {
      "type": "number",
      "default": 8
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "wedding_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.plan_tier": "multiday"
          }
        },
        {
          "user_condition": {
            "data.plan_tier": "destination"
          }
        },
        {
          "data.wedding_id": {
            "$in": "{{user.data.team_wedding_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.plan_tier": "multiday"
                  }
                },
                {
                  "user_condition": {
                    "data.plan_tier": "destination"
                  }
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                }
              ]
            }
          ]
        },
        {
          "data.wedding_id": {
            "$in": "{{user.data.team_wedding_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.plan_tier": "multiday"
                  }
                },
                {
                  "user_condition": {
                    "data.plan_tier": "destination"
                  }
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                }
              ]
            }
          ]
        },
        {
          "data.wedding_id": {
            "$in": "{{user.data.team_wedding_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.plan_tier": "multiday"
                  }
                },
                {
                  "user_condition": {
                    "data.plan_tier": "destination"
                  }
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                }
              ]
            }
          ]
        },
        {
          "data.wedding_id": {
            "$in": "{{user.data.team_wedding_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
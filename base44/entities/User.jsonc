{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "plan_tier": {
      "type": "string",
      "description": "The user's current paid plan tier, set server-side by the signup and payment webhooks. Used by RLS rules to enforce tier-gated entity access.",
      "enum": [
        "free",
        "single_day",
        "multiday",
        "destination"
      ],
      "default": "free"
    },
    "team_wedding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Wedding IDs this user has been invited to collaborate on as a team member. Set by the accept-team-invite function. Used by RLS rules to grant team members access to shared wedding data.",
      "default": []
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}